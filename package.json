{
  "name": "unite-pay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "husky",
    "push-test": "scripts/coolify.sh push-test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "oxfmt": "^0.59.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
